# =====================================================================
# reels-autopilot — salin ke .env (lokal) atau GitHub Actions Secrets.
# JANGAN commit file .env. JANGAN tempel nilai asli di chat.
# Nama secret harus sama dengan yang di SETUP_CHECKLIST.md.
#
# Semua layanan yang dipakai BERGRATIS. Tiap kategori punya rantai
# failover (lihat BLUEPRINT.md). Kosongkan kunci yang belum dibuat;
# router akan melewati provider itu dan memakai yang berikutnya.
# Akun non-Meta: arrowmichael17@gmail.com
# Akun Meta (FB Page, IG, Business Suite, developer app): radinalachmad@gmail.com
# =====================================================================

# --- Mode (default aman: tidak ada yang diposting) ---
DRY_RUN=true
# auto | veto | required
#   auto     = penuh otonom, Telegram hanya status (+ perintah /pause)
#   veto     = otomatis lanjut, bro bisa TOLAK sebelum jam tayang (rekomendasi)
#   required = wajib setujui dulu; jika timeout, pakai rank 1 (atau skip jika SKIP_ON_TIMEOUT=true)
APPROVAL_MODE=veto
AUTO_APPROVE_TIMEOUT_MIN=45
SKIP_ON_TIMEOUT=false
DAILY_QUOTA=5
LANGUAGE=id
TTS_VOICE=id-ID-ArdiNeural
# cadangan suara edge-tts (perempuan): id-ID-GadisNeural
TTS_RATE=-5%
TZ=Asia/Makassar

# --- LLM rantai: gemini -> groq -> github_models -> openrouter -> cloudflare -> huggingface -> template ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Token khusus, atau PAT dengan models:read. Di Actions, GITHUB_TOKEN otomatis (permission models: read).
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
# Model gratis OpenRouter berubah-ubah; pilih yang berakhiran :free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
# template = fallback lokal tanpa kunci (selalu tersedia)

# --- TTS rantai: edge-tts -> gtts -> piper -> espeak ---
# edge-tts dan gTTS tidak butuh kunci. Piper butuh biner + model (lihat SETUP).
PIPER_BIN=piper
PIPER_MODEL=
# contoh: /opt/piper/id_ID-news-medium.onnx

# --- Gambar stok rantai: pexels -> pixabay -> unsplash -> openverse -> wikimedia -> local ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Hosting MP4 (IG wajib URL publik) rantai: github_release -> r2 -> catbox ---
# none = jangan unggah (wajib untuk DRY_RUN; FB Page API bisa unggah biner tanpa URL)
VIDEO_HOST_CHAIN=github_release,r2,catbox
# Untuk GitHub Releases: repo publik (owner/nama). Di Actions, GITHUB_TOKEN otomatis.
GITHUB_RELEASES_REPO=
# Cloudflare R2 (tier gratis, akun arrowmichael17)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=

# --- Telegram bot (dibuat di @BotFather pada akun @achmadrd) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Meta: Facebook PAGE (bukan profil) + Instagram Creator/Business ---
# Akun: radinalachmad@gmail.com
# Graph API HANYA bisa publish Reels ke PAGE, bukan profil pribadi "Po Chai".
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_TOKEN=
META_GRAPH_VERSION=v26.0
FB_IS_AI_GENERATED=true

# --- Opsional ---
YOUTUBE_API_KEY=
HTTP_USER_AGENT=reels-autopilot/0.1 (Po Chai Kreator AI; personal pipeline)

# --- Jalur data (biasanya biarkan default) ---
# REELS_ROOT=
